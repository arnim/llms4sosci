#!/usr/bin/env bash
set -euo pipefail

# The R buildpack supplies RStudio and its authenticated Jupyter proxy.
# Install one pinned Quarto version, without requiring root at build time.
QUARTO_VERSION=1.8.26
archive="$(mktemp)"
trap 'rm -f "$archive"' EXIT
curl --fail --location --retry 3 \
  "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
  --output "$archive"
mkdir -p "$HOME/.local/share" "$HOME/.local/bin"
tar -xzf "$archive" -C "$HOME/.local/share"
ln -sf "$HOME/.local/share/quarto-${QUARTO_VERSION}/bin/quarto" "$HOME/.local/bin/quarto"
"$HOME/.local/bin/quarto" --version
