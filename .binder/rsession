#!/usr/bin/env python3
"""Forward selected runtime variables from our same-user RStudio parent.

RStudio clears these when launching R. Read them from the parent's process
memory on Linux, never from a credential file, and never print their values.
"""
import os
import pathlib
import sys

parent = pathlib.Path(f"/proc/{os.getppid()}")
if parent.stat().st_uid != os.getuid():
    raise RuntimeError("Expected RStudio parent to run as the same user")
entries = (parent / "environ").read_bytes().split(b"\0")
inherited = dict(item.split(b"=", 1) for item in entries if b"=" in item)
for name in (
    "JUPYTERHUB_API_TOKEN", "BLABLADOR_API_KEY", "OPENAI_API_KEY",
    "LLM_PROVIDER", "BLABLADOR_MODEL",
):
    value = inherited.get(os.fsencode(name))
    if value is not None and name not in os.environ:
        os.environ[name] = os.fsdecode(value)

binary = "/usr/lib/rstudio-server/bin/rsession"
os.execv(binary, [binary, *sys.argv[1:]])
